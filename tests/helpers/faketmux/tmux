#!/usr/bin/env bash
# Fake tmux shim: logic-tests tmux_type.sh WITHOUT touching real panes.
# Logs each invocation to $FT_LOG; capture-pane returns the busy marker for the
# first $FT_BUSY_CALLS calls (counter in $FT_STATE), then an idle screen.
LOG="${FT_LOG:?}"
STATE="${FT_STATE:?}"
BUSY_CALLS="${FT_BUSY_CALLS:-2}"
printf '%s\n' "$@" >> "$LOG"; printf 'END\n' >> "$LOG"

case "$1" in
  display-message) echo "%99"; exit 0 ;;
  capture-pane)
    n=0; [ -f "$STATE" ] && n=$(cat "$STATE")
    n=$((n + 1)); echo "$n" > "$STATE"
    if [ "$n" -le "$BUSY_CALLS" ]; then printf '\xe2\x9c\xbd Wrangling\xe2\x80\xa6 (3s \xc2\xb7 24 tokens)\n'
    else echo "idle prompt ready"; fi
    exit 0 ;;
  send-keys) exit 0 ;;
  *) exit 0 ;;
esac
